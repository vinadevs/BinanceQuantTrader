<?xml version="1.0"?>

<GeneralConfig>
  <LifeTime LifeTimeForStrategy="IntraDay"/>
  <EnableComplianceChecker Enable="true"/>
</GeneralConfig>

<OrderScheduler>
  <OrderSendingInverval AlarmIntervalSecond="1"/>
</OrderScheduler>

<TargetSymbol>
  <AllSymbols UseRemoteExchangeList="true" LocalListingFile="[ROOT_BQT_PATH]/Configurations/Common/BinanceListings.txt"/>
  <TradeSymbols List="BTCUSDT, ETHUSDT, BNBUSDT"/>
</TargetSymbol>

<Algorithm>
  <ArbitrageType Type="QuoteFutureAndHedgeSpot">
  <EntryEdgePriceThresholdDiff Value="100">  
  <QuoteOffset Value="0.5">
  <TickWidth Value="100">
</Algorithm>

<RiskTradingLimits>
  <Metrics MaxPositionSize="100" MaxDelta="10" MaxTheta="1" MaxGamma="1" MaxLoss="1000" MinEdge="1" MaxVolume="1000"/>
</RiskTradingLimits>
