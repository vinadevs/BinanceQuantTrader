<?xml version="1.0"?>
<GlobalSettings>
  <ApplicationDataPath Folder="[ROOT_BQT_PATH]\AppData"/>
</GlobalSettings>

<RealTimeMarketData>
  <UsingMarketData Name="BinanceMarketData" File="[ROOT_BQT_PATH]\Configurations\MarketData\BinanceMarketDataCfg.xml"/>
</RealTimeMarketData>

<StaticData>
</StaticData>

<HistoricalData>
</HistoricalData>

<BinanceAPI>
  <Connection ApiBinanceCom="api.binance.com" ApiBinancePort="443" ConnectionTimeoutMs="10000"/>
</BinanceAPI>

<TradingStrategy>
  <UsingStrategy Name="FomoStrategy" File="[ROOT_BQT_PATH]\Configurations\Strategy\Auto\FomoStrategy.xml"/>
</TradingStrategy>

<PortfolioInvestment>
</PortfolioInvestment>

<TradingModel>
  <Field Setting1="xxx" Setting2="yyy"/>
</TradingModel>

<TraderInfo>
  <UsingTrader Type="BinanceTrader"/>
  <Report TradeReport="true" OrderReport="true" BalanceReport="true" ExchangerPriceForOrdersReport="true" CalculateLossForOrdersReport="true" ReportToFilePath="[ROOT_BQT_PATH]\AppData\trade_results.txt"/>
</TraderInfo>

<ComplianceNRegulatory>
  <TradingLimits MaxRequestWeightPerMinute="5000" MaxOrdersPerTenSeconds="50" MaxOrdersPerTwentyFourHours="160000"/>
  <StaticExchangeProfile File="[ROOT_BQT_PATH]\Configurations\Common\BinanceStaticExchangeProfile.txt"/>
</ComplianceNRegulatory>

<RiskManagement>
  <StopLossManagement RiskPerTradePercent="1"/>
</RiskManagement>

<MessageServer>
  <CommunicationChannel TopicName="ExchangeSimulatorToAlgos" SubscriberAddress="tcp://localhost:5556"/>
</MessageServer>

<MessageTransporter>
  <CommunicationChannel TopicName="AlgosToExchangeSimulator" PublisherAddress="tcp://localhost:5558"/>
</MessageTransporter>

<BinanceWalletClient>
  <Connection ServerIpAddress="localhost" ServerPort="50051"/>
</BinanceWalletClient>

<BinanceExchangeClient>
  <Connection ServerIpAddress="localhost" ServerPort="50051"/>
</BinanceExchangeClient>