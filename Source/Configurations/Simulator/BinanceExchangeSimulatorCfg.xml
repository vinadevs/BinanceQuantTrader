<?xml version="1.0"?>

<MessageServer>
  <CommunicationChannel TopicName="AlgosToExchangeSimulator" SubscriberAddress="tcp://localhost:5559"/>
</MessageServer>

<MessageTransporter>
  <CommunicationChannel TopicName="ExchangeSimulatorToAlgos" PublisherAddress="tcp://localhost:5557"/>
</MessageTransporter>

<MatchingEngine>
  <UsingParticipant Name="RTMarketSpotParticipant" MaximumDownstreamOrderBookSize="10"/>
  <RealTimeMarketData>
	  <UsingMarketData Name="RealTimeMarketData" File="[ROOT_BQT_PATH]\Configurations\MarketData\BinanceMarketDataCfg.xml"/>
  </RealTimeMarketData>
  <OrderProcessing Delay="true" IntervalMilliseconds="1000"/>
</MatchingEngine>

<StaticData>
</StaticData>

<BinanceRestAPIServer>
  <Connection ServerIpAddress="0.0.0.0" ServerPort="12345"/>
</BinanceRestAPIServer>

<UserAccountManager>
  <GeneralSetting MaximumAccount="1"/>
  <SpotAccountInfo File="[ROOT_BQT_PATH]\Configurations\StaticData\spot_account_info_t.json"/>
  <FutureAccountInfo File="[ROOT_BQT_PATH]\Configurations\StaticData\future_account_info_t.json"/>
  <TestUserAccount ListUserID="{user_id,path_to_config};{user_id,path_to_config}"/>
</UserAccountManager>

<ExchangeRuleAndCompliance>
  <TradeCommissions MakerCommission="0.01" TakerCommission="0.05" BuyerCommission="0" SellerCommission="0"  FutureMakerCommission="0.0002" FutureTakerCommission="0.0004"/>
  <FutureMarginRateInfo File="[ROOT_BQT_PATH]\Configurations\StaticData\future_trading_margin_t.json"/>
</ExchangeRuleAndCompliance>

<ExchangeInfoManager>
  <ExchangeInfo File="[ROOT_BQT_PATH]\Configurations\StaticData\exchange_info_t.json"/>
</ExchangeInfoManager>

<UserTradeProfileManager>
	<FutureTradeSettings LeverageRate="1"/>
</UserTradeProfileManager>