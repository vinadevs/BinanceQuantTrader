<?xml version="1.0"?>

<MarketDataSource>
  <Source Type="RealTimeData"/>
</MarketDataSource>

<RealTimeMarketData>
  <Connection StreamBinanceCom="stream.binance.com" StreamConnectionPort="9443"/>
  <SubscriptionData IndividualBookTickerData="true" TradeData="true" IndividualMarketTickerData="true" AllMarketTickersData="true" IndividualMiniTickerData="true" AllMiniTickersData="false" AggregateTradeData="false" KlineCandleStickData="false" PartDepthData="false" DiffDepthData="false" UserData="false"/>
</RealTimeMarketData>

<MarketDataCapture>
  <DataCaptureMode Mode="PythonServer"/>
  <DataRepository Path="[ROOT_BQT_PATH]\AppData\"/>
</MarketDataCapture>

<ExchangeSimulatorMarketData>
  <MatchingForSymbols List="BTCUSDT,ETHUSDT,BNBUSDT"/>
</ExchangeSimulatorMarketData>

<SubscribingSymbol>
  <Symbols List="BTCUSDT,ETHUSDT,BNBUSDT"/>
</SubscribingSymbol>

<MessageTransporter>
  <CommunicationChannel TopicName="AlgosToPythonClient" PublisherAddress="tcp://localhost:5555"/>
</MessageTransporter>